---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import FAQ from "../components/FAQ.astro";
import { generalFAQ } from "../data/faq";
import { url } from "../utils/url";
---

<BaseLayout
  title="Electrical Contractor FAQ – West Monroe, LA | Fox Family Electric"
  description="Answers to common questions about electrical service calls, generator installation, licensing, virtual estimates, and service areas in Northeast Louisiana."
>
  <PageBanner
    eyebrow="Questions"
    heading="We've got answers"
    body="Find what you need to know about our services, pricing, and how we work with families like yours."
  >
    <div class="btn-group" slot="cta">
      <a href={url("/what-we-do")} class="btn btn-primary"
        >Explore our services</a
      >
      <a href={url("/contact")} class="btn btn-secondary">Contact us</a>
    </div>
  </PageBanner>

  <FAQ
    body="We handle the questions you have about our work and how we do it."
    faqs={generalFAQ}
    outro={{
      heading: "Still have questions?",
      body: "Reach out and we'll get back to you.",
      btnHref: "/contact",
      btnLabel: "Contact us",
    }}
  />
</BaseLayout>

<style>
  .btn-group {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }
</style>
