---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionGrid from "../components/SectionGrid.astro";
import { generatorNeeds } from "../data/iconBlocks";
import TextBlock from "../components/grid-blocks/TextBlock.astro";
import { generatorBenefits } from "../data/textBlocks";
import CTABlock from "../components/grid-blocks/CTABlock.astro";
import ReviewCarousel from "../components/ReviewCarousel";
---

<BaseLayout>
  <SectionGrid
    eyebrow="Reality"
    heading="Louisiana weather demands more than hope"
    body="Brutal summer heat, thunderstorms, hurricanes, and even ice storms are part of living here. When the grid goes down, your family needs power that doesn't depend on the utility company."
    columns={3}
  >
    {
      generatorNeeds.map((need) => {
        return (
          <div class="card-with-background">
            <h2 class="title">{need.heading}</h2>
            <p>{need.body}</p>
          </div>
        );
      })
    }
    <div class="btn-group" slot="cta">
      <a href="tel:3183309966" class="btn btn-primary">Call about generators</a>
    </div>
  </SectionGrid>

  <SectionGrid
    eyebrow="Benefits"
    heading="What a generator gives you"
    body="More than just lights and air conditioning"
    columns={3}
  >
    {
      generatorBenefits.map((benefit) => {
        return (
          <TextBlock
            heading={benefit.heading}
            body={benefit.body}
            align="left"
            card={true}
          />
        );
      })
    }
  </SectionGrid>

  <SectionGrid
    eyebrow="Support"
    heading="We handle it all"
    body="From the day we install your generator to years down the road, Fox Family Electric is here. We know your equipment, we know your home, and we show up when you need us."
    columns={2}
  >
    <CTABlock
      heading="Whole home backup power"
      body="Automatic standby generators kick on the moment power fails. Running on natural gas or propane, they keep your entire home running without you lifting a finger."
    >
      <div slot="cta" class="btn-group">
        <a href="tel:3183309966" class="btn btn-primary">Call to get started</a>
      </div>
    </CTABlock>
    <CTABlock
      heading="Backup power for your business"
      body="When the power goes out, your business can't afford to stop. We install and maintain commercial generators sized for your operation, so you stay open and your equipment stays protected."
    >
      <div slot="cta" class="btn-group">
        <a href="tel:3183309966" class="btn btn-primary">Call to get started</a>
      </div>
    </CTABlock>
  </SectionGrid>

  <ReviewCarousel client:visible />
</BaseLayout>

<style>
  .card-with-background {
    max-width: 400px;
    margin: auto;
    aspect-ratio: 800 / 1000;
    color: #fff;
    background-color: #222;
    padding: 2rem;
    border-radius: 1rem;
    overflow: hidden;
  }

  .card-with-background:nth-child(1) {
    background: url(../assets/card-backgrounds/LightningCard.jpg);
    background-size: cover;
    background-position: center bottom;
  }

  .card-with-background:nth-child(2) {
    background: url(../assets/card-backgrounds/DarkCard.jpg);
    background-size: cover;
    background-position: center bottom;
  }

  .card-with-background:nth-child(3) {
    background: url(../assets/card-backgrounds/PeaceCard.jpg);
    background-size: cover;
    background-position: center bottom;
  }

  .card-with-background .title {
    font-size: var(--text-2xl);
    line-height: 1.2;
    margin-bottom: 1rem;
  }
</style>
