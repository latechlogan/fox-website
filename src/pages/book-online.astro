---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import FAQ from "../components/FAQ.astro";
import { faqBookOnline } from "../data/faq";
import { url } from "../utils/url";
---

<BaseLayout>
  <PageBanner
    eyebrow="Simple"
    heading="Schedule your service"
    body="Pick a time that works for you and we'll take it from there."
  >
    <div class="btn-group" slot="cta">
      <a
        href="https://book.housecallpro.com/book/Fox-Family-Electric-LLC/78deb12faeff4e9cbf90f944d6d3c8f8"
        target="_blank"
        class="btn btn-primary">Book Now</a
      >
    </div>
  </PageBanner>

  <FAQ
    heading="Questions"
    body="Everything you need to know about booking with us"
    faqs={faqBookOnline}
    outro={{
      heading: "Still have questions?",
      body: "Reach out directly and talk to us.",
      btnHref: "/contact",
      btnLabel: "Contact",
    }}
  />
</BaseLayout>

<style>
  .btn-group {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }
</style>
