---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Image from "astro/components/Image.astro";
import liveSwitch from "../assets/liveswitch-logo.png";
import liveSwitchPhoto from "../assets/liveswitch-photo.png";
import SectionGrid from "../components/SectionGrid.astro";
import ReviewBlock from "../components/grid-blocks/ReviewBlock.astro";
import { reviews } from "../data/reviews";
import IconBlock from "../components/grid-blocks/IconBlock.astro";
import { businessLines } from "../data/iconBlocks";
import heroHouses from "../assets/hero-houses-photo.jpg";
import CTAPhone from "../components/cta/CTAPhone.astro";
import { url } from "../utils/url";
import { FaStar } from "react-icons/fa";
import HeroReviewRotator from "../components/HeroReviewRotator.jsx";
import generatorImage from "../assets/generator-homepage.png";
import foxCrew from "../assets/fox-fullcrew-old.webp";
---

<BaseLayout
  title="Electrician in West Monroe, LA | Fox Family Electric"
  description="Fox Family Electric is a family-owned electrical contractor serving West Monroe, Monroe, and all of Northeast Louisiana. Residential, commercial, and generators. Call 318-330-9966."
>
  <Hero
    heading="We're the electrical contractors trusted by your neighbors."
    body="Fox Family Electric has been reliably serving this community for generations. We show up on time, do the job right, and treat your home like it's our own."
  >
    <div class="image-wrapper hero-container" slot="image">
      <div class="hero-container__stars">
        <FaStar />
        <FaStar />
        <FaStar />
        <FaStar />
        <FaStar />
      </div>
      <div class="hero-container__stars">
        <FaStar />
        <FaStar />
        <FaStar />
        <FaStar />
        <FaStar />
      </div>
      <div class="hero-container__reviews">
        <HeroReviewRotator
          reviews={reviews.filter((review) => review.rotator === true)}
          client:load
        />
      </div>
      <Image src={heroHouses} alt="Fox Family Electric service area houses" />
    </div>
    <Fragment slot="buttons">
      <CTAPhone label="Book a service call" />
      <a href={url("/contact")} class="btn btn-secondary">Contact us</a>
    </Fragment>
  </Hero>

  <!-- reviews section -->
  <SectionGrid
    heading="Don't take our word for it."
    body="Highly rated across Louisiana for service calls, projects, and generator installations"
    columns={3}
  >
    {
      reviews.map((review) => {
        if (review.featured === true) {
          return <ReviewBlock review={review} />;
        }
      })
    }
  </SectionGrid>

  <!-- family/louisiana -->
  <Hero
    eyebrow="Family"
    heading="Built on trust. Rooted in Louisiana."
    body="Our family has been doing this work for three generations and we take pride in doing it right. We're not a big corporation. We're your neighbors, and every job we take on gets the same care we'd give our own home."
    reverse={true}
  >
    <div class="image-wrapper" slot="image">
      <Image src={foxCrew} alt="" />
    </div>
    <Fragment slot="buttons">
      <a href={url("/about-us")} class="btn btn-secondary">Meet the family</a>
    </Fragment>
  </Hero>

  <!-- electrical expertise -->
  <SectionGrid
    eyebrow="Expertise"
    heading="Everything electrical, handled by people who care."
    body="Whether it's a flickering outlet or a full commercial build, we handle it all — from routine repairs to large-scale projects, generator installations to panel upgrades. Whatever the job, we bring the same skill and the same standard."
    columns={4}
  >
    {
      businessLines.map((service) => {
        return (
          <IconBlock
            icon={service.icon}
            heading={service.heading}
            body={service.body}
          />
        );
      })
    }
    <div class="btn-group" slot="cta">
      <a href={url("/what-we-do/")} class="btn btn-secondary"
        >Explore our services</a
      >
    </div>
  </SectionGrid>

  <Hero
    eyebrow="Innovation"
    heading={"Get estimates faster.\nNo visit required."}
    body="With LiveSwitch, we assess your job through a live video call so you can get a quote faster and skip the dispatch fee. Just show us what you're working with and we'll take it from there."
  >
    <div class="image-wrapper" slot="image">
      <Image src={liveSwitchPhoto} alt="" />
    </div>
    <Image
      slot="logo"
      src={liveSwitch}
      alt="LiveSwitch logo"
      class="featured-logo"
    />
    <Fragment slot="buttons">
      <a href={url("/liveswitch")} class="btn btn-secondary"
        >Learn how it works</a
      >
    </Fragment>
  </Hero>

  <Hero
    eyebrow="Power"
    heading="Generators that keep Louisiana running."
    body="In Louisiana, storms come without warning. A generator isn't a luxury, it's peace of mind. We sell, install, and maintain them so you're never left in the dark."
    reverse={true}
  >
    <div class="image-wrapper" slot="image">
      <Image src={generatorImage} alt="" />
    </div>
    <Fragment slot="buttons">
      <a href={url("/generators")} class="btn btn-primary"
        >Call about generators</a
      >
    </Fragment>
  </Hero>
</BaseLayout>

<style>
  .hero-container {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    border-radius: 1rem;
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
  }

  .hero-container__reviews {
    position: absolute;
    bottom: 5%;
    left: 5%;
    width: 90%;
    background-color: hsla(0, 0%, 100%, 0.9);
    backdrop-filter: blur(4px);
    border-radius: 0.5rem;
    overflow: hidden;
    animation: growUp 0.5s ease-out both;
    transform-origin: bottom;
    animation-delay: 1700ms;
  }

  .hero-container__stars {
    position: absolute;
    font-size: 0.8rem;
    padding: 0.5rem;
    background-color: #fff;
    border-radius: 0.375rem;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: 0.125rem;
    animation: growUp 0.5s ease-out both;
    transform-origin: bottom;
  }

  .hero-container__stars::before {
    display: block;
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 11px;
    background-image: url("../assets/curved-arrow.svg");
    background-repeat: no-repeat;
  }

  .hero-container__stars > * {
    color: var(--gold-star);
  }

  .hero-container__stars:nth-child(1) {
    bottom: 59%;
    left: 10%;
    animation-delay: 900ms;
  }

  .hero-container__stars:nth-child(2) {
    bottom: 66%;
    left: 64%;
    animation-delay: 300ms;
  }

  @keyframes growUp {
    0% {
      transform: scale(0);
    }
    45% {
      transform: scale(1.03);
    }
    65% {
      transform: scale(1);
    }
    85% {
      transform: scale(1.01);
    }
    100% {
      transform: scale(1);
    }
  }

  .hero-rotator {
    padding: 0.625rem 0.75rem;
  }

  .hero-rotator__stars {
    display: flex;
    gap: 0.2rem;
    color: var(--gold-star);
    margin-bottom: 0.25rem;
  }

  .hero-rotator__body {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: #333;
    margin-bottom: 0.25rem;
  }

  .hero-rotator__name {
    font-size: var(--text-xs);
    color: #666;
  }

  .featured-logo {
    max-width: 200px;
    display: inline-block;
    margin: 1rem 0 0 0;
  }
</style>
