---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ReviewGrid from "../components/ReviewGrid.astro";

import placeholder from "../../src/assets/placeholder.jpg";
---

<BaseLayout>
  <Hero
    heading="We're the electrical contractors trusted by your neighbors."
    body="Fox Family Electric has been reliably serving this community for generations. We show up on time, do the job right, and treat your home like it's our own."
    image={placeholder}
    imageAlt="placholder image"
  >
    <!-- <ul slot="bullets">
      <li>Residential & Commercial</li>
      <li>24/7 Emergency Service</li>
      <li>Free Estimates</li>
    </ul>
    <Image
      slot="logo"
      src={liveSwitch}
      alt="LiveSwitch logo"
      class="featured-logo"
    /> -->
    <Fragment slot="buttons">
      <a href="" class="btn">Book a service call</a>
      <a href="" class="btn btn-secondary">Contact us</a>
    </Fragment>
  </Hero>

  <ReviewGrid
    heading="Don't take our word for it."
    body="Highly rated across Louisiana for service calls, projects, and generator installations"
  />

  <Hero
    eyebrow="Family"
    heading="Built on trust. Rooted in Louisiana."
    body="Our family has been doing this work for three generations and we take pride in doing it right. We're not a big corporation. We're your neighbors, and every job we take on gets the same care we'd give our own home."
    image={placeholder}
    imageAlt="placholder image"
    reverse="true"
  >
    <Fragment slot="buttons">
      <a href="" class="btn btn-secondary">Meet the family</a>
    </Fragment>
  </Hero>
</BaseLayout>

<style>
  .featured-logo {
    display: inline-block;
    margin: 1rem 0 0 0;
  }
</style>
