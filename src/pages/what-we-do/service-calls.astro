---
import IconBlock from "../../components/grid-blocks/IconBlock.astro";
import SectionGrid from "../../components/SectionGrid.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { serviceCallItems } from "../../data/iconBlocks";
import { serviceCallSteps } from "../../data/iconBlocks";
import ReviewCarousel from "../../components/ReviewCarousel.jsx";
---

<BaseLayout>
  <SectionGrid
    eyebrow="Service"
    heading="We handle the electrical problems that matter"
    body="Whether it's a flickering light or a complete power loss, we've seen it all and fixed it all. Our service calls cover everything from simple repairs to complex troubleshooting."
    columns={4}
  >
    {
      serviceCallItems.map((service) => {
        return (
          <IconBlock
            icon={service.icon}
            heading={service.heading}
            body={service.body}
          />
        );
      })
    }
  </SectionGrid>

  <SectionGrid
    eyebrow="Simple"
    heading="Three steps to fixed"
    body="We make it easy when things go wrong."
  >
    {
      serviceCallSteps.map((step, index) => {
        if (index === 0) {
          return (
            <>
              <IconBlock
                icon={step.icon}
                heading={step.heading}
                body={step.body}
                align="left"
                card={true}
              >
                <div class="btn-group" slot="cta">
                  <a href="#" class="btn btn-primary">
                    Book a service call
                  </a>
                </div>
              </IconBlock>
            </>
          );
        } else {
          return (
            <IconBlock
              icon={step.icon}
              heading={step.heading}
              body={step.body}
              align="left"
              card={true}
            />
          );
        }
      })
    }
  </SectionGrid>

  <ReviewCarousel client:visible />
</BaseLayout>

<style></style>
