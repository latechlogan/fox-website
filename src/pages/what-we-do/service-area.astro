---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import ReviewCarousel from "../../components/ReviewCarousel";
import SectionGrid from "../../components/SectionGrid.astro";
import CTABlock from "../../components/grid-blocks/CTABlock.astro";
import CTAPhone from "../../components/cta/CTAPhone.astro";
---

<BaseLayout>
  <PageBanner
    eyebrow="Community"
    heading="Building on trust across Louisiana"
    body="We've been serving Louisiana families and businesses for years, building relationships one job at a time. From the smallest repair to the biggest project, we treat every customer like a neighbor — because that's exactly what they are."
  >
    <div class="btn-group center" slot="cta">
      <CTAPhone label="Book a service call" />
      <a href="/about" class="btn btn-secondary">Our story</a>
    </div>
  </PageBanner>

  <ReviewCarousel client:visible />

  <SectionGrid
    eyebrow="Services"
    heading="What we bring to your neighborhood"
    body="Whether it's a midnight outage or a new build from the ground up, we handle it all. Same reliable service, same family values, no matter the job."
    columns={2}
  >
    <CTABlock
      heading="Service"
      body="Electrical issues don't keep business hours. When something goes wrong at home, we show up, figure it out, and get it fixed right."
    >
      <div slot="cta" class="btn-group">
        <CTAPhone label="Book a service call" />
        <a href="/what-we-do/service-calls" class="btn btn-secondary"
          >Learn about service calls</a
        >
      </div>
    </CTABlock>
    <CTABlock
      heading="Project"
      body="From new construction to full rewires and generator installations, we handle electrical work of any scale across Louisiana."
    >
      <div slot="cta" class="btn-group">
        <CTAPhone label="Start a project" />
        <!-- <a href="/what-we-do/projects" class="btn btn-secondary"
          >Learn about projects</a
        > -->
      </div>
    </CTABlock>
  </SectionGrid>
</BaseLayout>

