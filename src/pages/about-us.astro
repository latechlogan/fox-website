---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { Image } from "astro:assets";
import placeholder from "../../src/assets/placeholder.jpg";
const showHeroImage = false; // flip to true when client provides photo
import { url } from "../utils/url";
import foxCrew from "../assets/fox-fullcrew-old.webp";
---

<BaseLayout
  title="Family-Owned Electricians in West Monroe, LA | Fox Family Electric"
  description="Three generations of trusted electrical work in Louisiana. Fox Family Electric is family-owned, fully licensed, and committed to doing every job right."
>
  <Hero
    heading="Three generations built this on trust"
    body="Our story started simple. A man who knew electrical work, who did it right, and who treated every job like it mattered. His son learned the trade the same way — watching, doing, and understanding that a family's safety depends on honest work. Now his children carry that forward, and every electrician we hire learns the same thing on day one."
    noImage={!showHeroImage}
  >
    {
      showHeroImage && (
        <div class="image-wrapper" slot="image">
          <Image src={placeholder} alt="" />
        </div>
      )
    }
    <!-- <a
      href={url("/about-us/#team-grid")}
      slot="buttons"
      class="btn btn-secondary">Meet the team</a
    > -->
  </Hero>

  <div class="fw-container" id="mission">
    <div class="mw-container mission">
      <h2 class="mission__heading">Mission</h2>
      <strong class="mission__body"
        >To keep Louisiana families safe and connected through honest electrical
        work. We show up on time, we do the job right, and we treat your home
        the way we'd treat our own.</strong
      >
    </div>
  </div>

  <Hero
    heading="Building lasting relationships across Louisiana"
    body="We're committed to training the next generation of electricians who understand that this work is about more than wiring and panels. It's about being someone people can count on. It's about community. It's about doing things the right way, even when no one's watching."
    reverse={true}
  >
    <div class="image-wrapper" slot="image">
      <Image src={foxCrew} alt="" />
    </div>
    <a href={url("/careers")} slot="buttons" class="btn btn-secondary"
      >See our careers page</a
    >
  </Hero>
</BaseLayout>

<!-- custom styling -->
<style>
  .hero-bullets li {
    margin: 0 0 0.5rem 0;
  }

  .mission {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .mission__heading {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0 0 1rem 0;
  }

  .mission__body {
    font-size: var(--text-xl);
    text-wrap: pretty;
    max-width: 800px;
  }
</style>
