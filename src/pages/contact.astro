---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MdOutlineLocationOn } from "react-icons/md";
import { MdOutlineMailOutline } from "react-icons/md";
import { MdOutlinePhone } from "react-icons/md";
---

<BaseLayout>
  <div class="contact-page mw-container">
    <!-- Section 1: Contact Info -->
    <section class="contact-info">
      <!-- <p class="eyebrow">Reach</p> -->
      <h2 class="text-4xl">Get in touch</h2>
      <p>
        We answer calls and emails promptly and will get back to you as soon as
        we can.
      </p>
      <ul class="contact-info__list">
        <li class="contact-info__item">
          <span
            class="contact-info__item-icon"
            style="font-size: 1.3rem"
            aria-hidden="true"
          >
            <MdOutlinePhone />
          </span>
          <!-- <span class="contact-info__item-label">Phone</span> -->
          <a class="contact-info__item-value" href="tel:3183309966">
            318-330-9966
          </a>
        </li>

        <li class="contact-info__item">
          <span
            class="contact-info__item-icon"
            style="font-size: 1.2rem"
            aria-hidden="true"
          >
            <MdOutlineMailOutline />
          </span>
          <!-- <span class="contact-info__item-label">Email</span> -->
          <a
            class="contact-info__item-value"
            href="mailto:foxfamilyelectric@gmail.com"
          >
            foxfamilyelectric@gmail.com
          </a>
        </li>

        <li class="contact-info__item">
          <span
            class="contact-info__item-icon"
            style="font-size: 1.3rem"
            aria-hidden="true"
          >
            <MdOutlineLocationOn />
          </span>
          <!-- <span class="contact-info__item-label">Location</span> -->
          <address class="contact-info__item-value">
            212 Haynes St, West Monroe, Louisiana 71291
          </address>
        </li>
      </ul>
    </section>

    <!-- Section 2: Contact Form -->
    <section class="contact-form-section">
      <div class="contact-form-section__inner">
        <form id="contact-form" class="contact-form" novalidate>
          <!-- Web3Forms access key -->
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY" />

          <!-- Honeypot spam protection -->
          <input
            type="checkbox"
            name="botcheck"
            class="contact-form__honeypot"
            tabindex="-1"
            autocomplete="off"
          />

          <!-- Full Name -->
          <div class="contact-form__field">
            <label class="contact-form__label" for="full-name">
              Full Name <span class="contact-form__required" aria-hidden="true"
                >*</span
              >
            </label>
            <input
              class="contact-form__input"
              type="text"
              id="full-name"
              name="name"
              required
              autocomplete="name"
            />
          </div>

          <!-- Phone -->
          <div class="contact-form__field">
            <label class="contact-form__label" for="phone">
              Phone <span class="contact-form__required" aria-hidden="true"
                >*</span
              >
            </label>
            <input
              class="contact-form__input"
              type="tel"
              id="phone"
              name="phone"
              required
              autocomplete="tel"
            />
          </div>

          <!-- Email -->
          <div class="contact-form__field">
            <label class="contact-form__label" for="email"> Email </label>
            <input
              class="contact-form__input"
              type="email"
              id="email"
              name="email"
              autocomplete="email"
            />
          </div>

          <!-- Topic -->
          <fieldset class="contact-form__fieldset">
            <legend class="contact-form__legend">
              Topic <span class="contact-form__required" aria-hidden="true"
                >*</span
              >
            </legend>
            <div class="contact-form__radio-group">
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="topic"
                  value="General Inquiry"
                  required
                />
                General Inquiry
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="topic"
                  value="Request a Quote"
                />
                Request a Quote
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="topic"
                  value="Service Call / Repair"
                />
                Service Call / Repair
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="topic"
                  value="Project Consultation"
                />
                Project Consultation
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="topic"
                  value="Generator Inquiry"
                />
                Generator Inquiry
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="topic"
                  value="Billing / Invoice"
                />
                Billing / Invoice
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="topic"
                  value="Other"
                />
                Other
              </label>
            </div>
          </fieldset>

          <!-- Self-Identification -->
          <fieldset class="contact-form__fieldset">
            <legend class="contact-form__legend">
              I am a… <span class="contact-form__required" aria-hidden="true"
                >*</span
              >
            </legend>
            <div class="contact-form__radio-group">
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="customer_type"
                  value="Homeowner"
                  required
                />
                Homeowner
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="customer_type"
                  value="Business Owner"
                />
                Business Owner
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="customer_type"
                  value="General Contractor"
                />
                General Contractor
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="customer_type"
                  value="Property Manager"
                />
                Property Manager
              </label>
              <label class="contact-form__radio-label">
                <input
                  class="contact-form__radio"
                  type="radio"
                  name="customer_type"
                  value="Other"
                />
                Other
              </label>
            </div>
          </fieldset>

          <!-- Message -->
          <div class="contact-form__field">
            <label class="contact-form__label" for="message">
              Message <span class="contact-form__required" aria-hidden="true"
                >*</span
              >
            </label>
            <textarea
              class="contact-form__textarea"
              id="message"
              name="message"
              required
              rows="6"></textarea>
          </div>

          <button class="btn contact-form__submit" type="submit">
            Send Message
          </button>
        </form>

        <p id="contact-form-success" class="contact-form__success" hidden>
          Thanks for reaching out! We'll get back to you as soon as we can.
        </p>

        <p id="contact-form-error" class="contact-form__error" hidden>
          Something went wrong. Please try again or call us at
          <a href="tel:3183309966">318-330-9966</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const successMsg = document.getElementById("contact-form-success");
  const errorMsg = document.getElementById("contact-form-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    if (submitBtn) submitBtn.disabled = true;

    successMsg?.setAttribute("hidden", "");
    errorMsg?.setAttribute("hidden", "");

    const data = Object.fromEntries(new FormData(form));

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        form.reset();
        successMsg?.removeAttribute("hidden");
      } else {
        errorMsg?.removeAttribute("hidden");
        if (submitBtn) submitBtn.disabled = false;
      }
    } catch {
      errorMsg?.removeAttribute("hidden");
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  .contact-page {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .contact-info,
  .contact-form-section {
    width: 100%;
  }

  .contact-info__item {
    display: grid;
    grid-template-columns: 24px auto;
    margin: 1rem 0 0 0;
  }

  .contact-info__item-icon {
    padding: 0.1rem 0 0 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
  }

  .contact-info__item-value {
    padding: 0 0 0 0.75rem;
  }

  .contact-info__list {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;

    input {
      width: 100%;
    }
  }

  .contact-form__radio-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  @media screen and (min-width: 768px) {
    .contact-page {
      flex-direction: row;
      gap: 4rem;
    }

    .contact-info {
      width: 45%;
    }

    .contact-form-section {
      width: 55%;
    }
  }
</style>
