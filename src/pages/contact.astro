---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MdOutlineLocationOn } from "react-icons/md";
import { MdOutlineMailOutline } from "react-icons/md";
import { MdOutlinePhone } from "react-icons/md";
import ContactForm from "../components/ContactForm.jsx";
---

<BaseLayout>
  <div class="contact-page mw-container">
    <!-- Section 1: Contact Info -->
    <section class="contact-info">
      <!-- <p class="eyebrow">Reach</p> -->
      <h2 class="text-4xl">Get in touch</h2>
      <p>
        We answer calls and emails promptly and will get back to you as soon as
        we can.
      </p>
      <ul class="contact-info__list">
        <li class="contact-info__item">
          <span
            class="contact-info__item-icon"
            style="font-size: 1.3rem"
            aria-hidden="true"
          >
            <MdOutlinePhone />
          </span>
          <!-- <span class="contact-info__item-label">Phone</span> -->
          <a class="contact-info__item-value" href="tel:3183309966">
            318-330-9966
          </a>
        </li>

        <li class="contact-info__item">
          <span
            class="contact-info__item-icon"
            style="font-size: 1.2rem"
            aria-hidden="true"
          >
            <MdOutlineMailOutline />
          </span>
          <!-- <span class="contact-info__item-label">Email</span> -->
          <a
            class="contact-info__item-value"
            href="mailto:foxfamilyelectric@gmail.com"
          >
            foxfamilyelectric@gmail.com
          </a>
        </li>

        <li class="contact-info__item">
          <span
            class="contact-info__item-icon"
            style="font-size: 1.3rem"
            aria-hidden="true"
          >
            <MdOutlineLocationOn />
          </span>
          <!-- <span class="contact-info__item-label">Location</span> -->
          <address class="contact-info__item-value">
            212 Haynes St, West Monroe, Louisiana 71291
          </address>
        </li>
      </ul>
    </section>

    <!-- Section 2: Contact Form -->
    <section class="contact-form-section">
      <div class="contact-form-section__inner">
        <ContactForm client:load />
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .contact-page {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .contact-info {
    width: 100%;
    margin: 0 0 4rem 0;
  }

  .contact-form-section {
    width: 100%;
  }

  .contact-info__item {
    display: grid;
    grid-template-columns: 24px auto;
    margin: 1rem 0 0 0;
  }

  .contact-info__item-icon {
    padding: 0.1rem 0 0 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
  }

  .contact-info__item-value {
    padding: 0 0 0 0.75rem;
  }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(max(200px, calc(50% - 0.5rem)), 1fr)
    );
    gap: 1rem;
  }

  .contact-form__label {
    text-transform: uppercase;
    font-size: 0.625rem;
    letter-spacing: 0.05rem;
    margin: 0 0 0.5rem 0;
  }

  .contact-form__input,
  .contact-form__textarea {
    padding: 0.25rem 0.5rem;
    border-width: 1px;
    border-color: #222;
    border-radius: 0.375rem;
  }

  .contact-info__list {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;

    input {
      width: 100%;
    }
  }

  .contact-form__fieldset {
    padding: 0;
    margin: 0;
    border: none;
  }

  .contact-form__field:has(textarea) {
    grid-column: 1 / -1;
  }

  .contact-form__textarea {
    width: 100%;
  }

  .contact-form__submit {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .contact-form__honeypot {
    position: absolute;
    left: -9999px;
  }

  .contact-form__legend {
    margin: 0 0 0.2rem 0;
  }

  .contact-form__radio-group {
    display: grid;
    grid-template-columns: 1fr;
  }

  .contact-form__radio-label {
    padding: 0.1rem 0;
  }

  .contact-form__radio {
    margin: 0 0.5rem 0 0;
  }

  @media screen and (min-width: 768px) {
    .contact-page {
      flex-direction: row;
      gap: 4rem;
    }

    .contact-info {
      width: 45%;
    }

    .contact-form-section {
      width: 55%;
    }
  }
</style>
