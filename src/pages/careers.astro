---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { Image } from "astro:assets";
import careersHero from "../assets/careers-hero.jpg";
import SectionGrid from "../components/SectionGrid.astro";
import IconBlock from "../components/grid-blocks/IconBlock.astro";
import { careerBenefits } from "../data/iconBlocks";
import { url } from "../utils/url";
---

<BaseLayout
  title="Electrician Jobs in West Monroe, LA | Fox Family Electric"
  description="Join a family-owned electrical company that treats people right. Fox Family Electric is hiring electricians in West Monroe, Louisiana. Competitive pay. Apply today."
>
  <Hero
    eyebrow="Careers"
    heading="Why we're different"
    body={"Work here and you're not just clocking hours. You're part of a family business that treats people right, takes pride in the work, and invests in the people who show up every day."}
  >
    <div class="image-wrapper" slot="image">
      <Image class="careers__hero-image" src={careersHero} alt="" />
    </div>
    <a href={url("/application")} class="btn btn-primary" slot="buttons"
      >Apply now</a
    >
  </Hero>

  <SectionGrid
    eyebrow="Benefits"
    heading="What we offer team members"
    body="We believe good people deserve good benefits. Here's what you get when you join Fox Family Electric."
    columns={4}
  >
    {
      careerBenefits.map((benefit) => {
        return (
          <IconBlock
            icon={benefit.icon}
            heading={benefit.heading}
            body={benefit.body}
          />
        );
      })
    }
    <div slot="cta" class="btn-group center">
      <a href={url("/application")} class="btn btn-primary">Apply Now</a>
    </div>
  </SectionGrid>
</BaseLayout>

<style>
  .careers__hero-image {
    border-radius: 1rem;
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
  }
</style>
