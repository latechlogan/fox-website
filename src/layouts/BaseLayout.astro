---
import Header from "../components/Header.astro";
import Analytics from "../components/Analytics.astro";
import GlobalCTA from "../components/GlobalCTA.astro";
import Footer from "../components/Footer.astro";
import "../css/global.css";
import "../css/forms.css";
import { getImage } from "astro:assets";
import foxLogo from "../assets/redfox_highres.jpg";
import { business } from "../data/business";

const { title, description } = Astro.props;

const logo = await getImage({ src: foxLogo });
const siteUrl = new URL("/", Astro.site);
const logoUrl = new URL(logo.src, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ElectricalContractor",
  "@id": `${siteUrl}#business`,
  name: business.name,
  legalName: business.legalName,
  url: siteUrl.toString(),
  logo: logoUrl.toString(),
  image: logoUrl.toString(),
  telephone: business.telephone,
  email: business.email,
  address: {
    "@type": "PostalAddress",
    ...business.address,
  },
  geo: {
    "@type": "GeoCoordinates",
    ...business.geo,
  },
  areaServed: business.areaServed.map(({ type, name }) => ({
    "@type": type,
    name,
  })),
  openingHoursSpecification: business.openingHours.map((hours) => ({
    "@type": "OpeningHoursSpecification",
    ...hours,
  })),
  sameAs: business.sameAs,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- font link -->
    <link
      href="https://api.fontshare.com/v2/css?f[]=spline-sans@1&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body>
    <Header />
    <slot />
    <GlobalCTA />
    <Footer />
  </body>
</html>
