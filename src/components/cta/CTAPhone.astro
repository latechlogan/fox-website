---
import { MdLocalPhone } from "react-icons/md";
const { label } = Astro.props;
---

<a href="tel:3183309966" class="btn">
  <span class="phone-icon">
    <MdLocalPhone />
  </span>
  {label}
</a>

<style>
  .btn {
    padding-left: 0.8rem;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 0.5rem;
  }
</style>
