---
const { heading, body, align = "center", card = false } = Astro.props;
---

<div class={`text-block ${align} ${card ? "card" : ""}`}>
  <strong class="text-block__heading">{heading}</strong>
  <p class="text-block__body">{body}</p>
  <slot name="cta" />
</div>

<style>
  .text-block {
    width: 100%;
    max-width: 400px;
    height: 100%;
    margin: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 0.5rem;
  }

  .text-block.left {
    text-align: left;
    align-items: flex-start;
  }

  .text-block.card {
    padding: 2rem;
    border: 1px solid #ccc;
    border-radius: 0.375rem;
  }

  .text-block__heading {
    font-size: var(--text-lg);
    line-height: 1.2;
    margin: 1rem 0 0 0;
  }

  .text-block__body {
    /* text-wrap: balance; */
    flex-grow: 1;
  }
</style>
