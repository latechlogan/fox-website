---
import { Image } from "astro:assets";
import { FaStar } from "react-icons/fa";
const { review } = Astro.props;
---

<div class="review-block">
  <div class="star-wrapper">
    {Array.from({ length: review.stars }, (_, i) => <FaStar />)}
  </div>
  <p class="review">{review.body}</p>
  <div class="reviewer">
    {
      review.photo && (
        <div class="reviewer__photo-wrapper">
          <Image src={review.photo} alt="" class="reviewer__photo" />
        </div>
      )
    }
    <div class="reviewer__info-wrapper">
      <strong class="reviewer__name text-base">{review.name}</strong>
      <p class="reviewer__desc text-base">{review.description}</p>
    </div>
  </div>
</div>

<style>
  .review-block {
    padding: 2rem;
    border: 1px solid #f0f0f0;
    background-color: #f6f6f6;
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .star-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .star-wrapper > * {
    color: var(--gold-star);
    font-size: 1.2rem;
  }

  .review {
    flex-grow: 1;
  }

  .reviewer {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
  }

  .reviewer__photo-wrapper {
    width: 48px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
  }
</style>
