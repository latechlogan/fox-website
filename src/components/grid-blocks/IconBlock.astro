---
const {
  icon: Icon,
  heading,
  body,
  align = "center",
  card = false,
} = Astro.props;
---

<div class={`icon-block ${align} ${card ? "card" : ""}`}>
  <Icon size="2.4rem" />
  <strong class="icon-block__heading">{heading}</strong>
  <p class="icon-block__body">{body}</p>
  <slot name="cta" />
</div>

<style>
  .icon-block {
    width: 100%;
    max-width: 400px;
    height: 100%;
    margin: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-block.left {
    text-align: left;
    align-items: flex-start;
  }

  .icon-block.card {
    padding: 2rem;
    border: 1px solid #f0f0f0;
    background-color: #f6f6f6;
    border-radius: 1rem;
  }

  .icon-block__heading {
    font-size: var(--text-lg);
    line-height: 1.2;
    margin: 1rem 0 0 0;
  }

  .icon-block__body {
    /* text-wrap: balance; */
    flex-grow: 1;
  }
</style>
