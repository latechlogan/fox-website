---
import type { FAQ } from "../data/faq";
import SectionIntro from "./SectionIntro.astro";
const { body, faqs, outro } = Astro.props;
---

<div class="fw-container">
  <div class="mw-container faq">
    <div class="faq-intro">
      <SectionIntro heading="Common Questions" body={body} />
    </div>

    <div class="faq-content">
      {
        faqs.map(({ question, answer }: FAQ) => (
          <details class="faq__item">
            <summary class="faq__question">{question}</summary>
            <p class="faq__answer">{answer}</p>
          </details>
        ))
      }
    </div>

    {
      outro && (
        <div class="faq-outro">
          <strong class="text-2xl faq-outro__heading">{outro.heading}</strong>
          <p class="faq-outro__body">{outro.body}</p>
          <a href={outro.btnHref} class="btn btn-secondary faq-outro__btn">
            {outro.btnLabel}
          </a>
        </div>
      )
    }
  </div>
</div>

<style>
  .mw-container {
    max-width: 800px;
    margin-right: auto;
    margin-left: auto;
  }

  .faq-intro {
    text-align: center;
    margin: 0 0 2rem 0;
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .faq__item:first-child {
    border-top: 1px solid var(--color-border, #e2e8f0);
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: "+";
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .faq__item[open] > .faq__question::after {
    transform: rotate(45deg);
  }

  .faq__answer {
    margin: 0 0 1.25rem 0;
  }

  .faq-content {
    margin: 0 0 2rem 0;
  }

  .faq-outro {
    text-align: center;
  }

  .faq-outro__heading {
    display: block;
    margin: 0 0 0.5rem 0;
  }

  .faq-outro__btn {
    margin: 2rem 0 0 0;
  }

  @media screen and (min-width: 768px) {
    .faq-intro,
    .faq-content {
      margin: 0 0 4rem 0;
    }
  }
</style>
