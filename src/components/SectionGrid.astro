---
import SectionIntro from "./SectionIntro.astro";
const { eyebrow, heading, body, columns = 3 } = Astro.props;
---

<div class="fw-container">
  <div class="mw-container section-grid">
    <div class="section-grid__intro">
      <SectionIntro {eyebrow} {heading} {body} />
    </div>
    <div class={`section-grid__grid cols-${columns}`}>
      <slot />
    </div>
    <slot name="cta" />
  </div>
</div>

<style>
  .section-grid {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
  }

  .section-grid__intro {
    text-align: center;
    max-width: 900px;
    margin: 0 0 1rem 0;
  }

  .section-grid__grid.cols-2,
  .section-grid__grid.cols-3,
  .section-grid__grid.cols-4 {
    width: 100%;
    margin: 1rem 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 600px) {
    .section-grid__grid.cols-2 {
      grid-template-columns: 1fr 1fr;
    }

    .section-grid__grid.cols-3 {
      grid-template-columns: 1fr 1fr;
    }

    .section-grid__grid.cols-4 {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-grid__grid.cols-3 {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .section-grid__grid.cols-4 {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
  }
</style>
