---
import SectionIntro from "./SectionIntro.astro";
const { eyebrow, heading, body, columns = 3, cta } = Astro.props;
---

<div class="fw-container">
  <div class="mw-container section-grid">
    <div class="section-grid__intro">
      <SectionIntro {eyebrow} {heading} {body} />
    </div>
    <div
      class={`section-grid__grid ${columns === 3 ? "three-column" : "four-column"}`}
    >
      <slot />
    </div>
    {
      cta && (
        <div class="section-grid__cta btn-group">
          <a
            href={cta.href}
            class={`btn ${cta.secondary ? "btn-secondary" : ""}`}
          >
            {cta.label}
          </a>
        </div>
      )
    }
  </div>
</div>

<style>
  .section-grid {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
  }

  .section-grid__intro {
    text-align: center;
    max-width: 900px;
    margin: 0 0 1rem 0;
  }

  .section-grid__grid.three-column,
  .section-grid__grid.four-column {
    width: 100%;
    margin: 1rem 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 600px) {
    .section-grid__grid.three-column {
      grid-template-columns: 1fr 1fr;
    }

    .section-grid__grid.four-column {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 1024px) {
    .section-grid__grid.three-column {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .section-grid__grid.four-column {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
  }
</style>
