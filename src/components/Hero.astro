---
import SectionIntro from "./SectionIntro.astro";

const { eyebrow, heading, body, reverse, noImage } = Astro.props;
---

<div class="fw-container">
  <div class={`mw-container hero ${reverse ? "reverse" : ""}`}>
    <div class={`content-wrapper ${noImage ? "content-wrapper--centered" : ""}`}>
      <SectionIntro eyebrow={eyebrow} heading={heading} body={body} />

      <!-- optional slots for dynamic content display -->
      <!-- styling for slot content must be done in the page it's displayed on -->
      <slot name="bullets" />
      <slot name="logo" />

      <div class="btn-group">
        <slot name="buttons" />
      </div>
    </div>

    <slot name="image" />
  </div>
</div>

<style>
  .hero {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: 2rem;
  }

  .hero.reverse {
    flex-direction: row-reverse;
  }

  .content-wrapper {
    width: 100%;
  }

  .content-wrapper--centered {
    text-align: center;
    align-items: center;
    display: flex;
    flex-direction: column;
    max-width: 900px;
    margin: auto;
  }

  .content-wrapper--centered .btn-group {
    justify-content: center;
  }

  @media screen and (min-width: 768px) {
    .hero {
      flex-wrap: nowrap;
    }
  }
</style>
