---
import { Image } from "astro:assets";
import foxLogo from "../../src/assets/redfox_highres.jpg";

import { SocialIcon } from "react-social-icons";
import "react-social-icons/facebook";
import "react-social-icons/instagram";
import "react-social-icons/x";
import "react-social-icons/linkedin";
import "react-social-icons/youtube";
---

<footer class="fw-container">
  <div class="mw-container footer">
    <div class="footer__intro">
      <a href="/" class="banner" aria-label="Fox Family Electric — home">
        <Image src={foxLogo} alt="Fox Family Electric Logo" />
      </a>
      <div class="highlight">
        <strong>Fox Family Electric. Serving Louisiana with pride.</strong>
        <p>Ready to get started? We'd love to hear from you.</p>
      </div>
      <div class="cta">
        <strong
          >Book a service call:&ensp;<a href="tel:3183309966">318-330-9966</a
          ></strong
        >
        <p>Contact us:&ensp;<a href="#">[email address]</a></p>
      </div>
      <div class="social">
        <SocialIcon
          url="www.facebook.com"
          style={{ width: "2rem", height: "2rem" }}
          bgColor="#222"
        />
        <SocialIcon
          url="www.instagram.com"
          style={{ width: "2rem", height: "2rem" }}
          bgColor="#222"
        />
        <SocialIcon
          url="www.x.com"
          style={{ width: "2rem", height: "2rem" }}
          bgColor="#222"
        />
        <SocialIcon
          url="www.linkedin.com"
          style={{ width: "2rem", height: "2rem" }}
          bgColor="#222"
        />
        <SocialIcon
          url="www.youtube.com"
          style={{ width: "2rem", height: "2rem" }}
          bgColor="#222"
        />
      </div>
    </div>
    <ul class="footer__nav">
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Service calls</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Projects</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Service area</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">FAQ</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Generators</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Our Story</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Mission and vision</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Virtual estimates</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Careers</a>
      </li>
      <li class="footer__nav-element">
        <a href="#" class="footer__nav-link">Contact</a>
      </li>
    </ul>
    <div class="fine-print">
      <p class="copyright">
        &copy;2026 Fox Family Electric. All rights reserved.
      </p>
      <ul class="fine-print__link-group">
        <li><a href="#" class="fine-print__link">Privacy policy</a></li>
        <li><a href="#" class="fine-print__link">Terms of service</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-intro {
    margin: 0 2rem 0 0;
  }

  .banner img {
    width: 100%;
    max-width: 96px;
    height: auto;
    margin: 0 0 1.5rem 0;
  }

  .highlight {
    margin: 0 0 1rem 0;
  }

  .cta {
    margin: 0 0 2rem 0;
  }

  .social {
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__nav {
    list-style-type: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-column-gap: 2rem;
  }

  .footer__nav-element {
    padding: 0.25rem 0;
  }

  .footer__nav-link {
    text-decoration: none;
  }

  .fine-print {
    width: 100%;
    padding: 1rem 0 0 0;
    margin: 1rem 0 0 0;
    border-top: 1px solid #ccc;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
  }

  .fine-print .copyright,
  .fine-print__link {
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .fine-print__link-group {
    list-style-type: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 0.5rem;
  }
</style>
