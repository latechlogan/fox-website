---
const { eyebrow, heading, body } = Astro.props;
const paragraphs: string[] = Array.isArray(body) ? body : [body];
---

{eyebrow && <p class="eyebrow">{eyebrow}</p>}
<h2 class="text-4xl text-heading">{heading}</h2>
{paragraphs.map((p) => <p class="text-base">{p}</p>)}

<style>
  .eyebrow {
    font-weight: 600;
    margin: 0 0 1rem 0;
  }

  .text-heading {
    white-space: pre-wrap;
    margin: 0 0 1rem 0;
  }

  .text-base {
    margin: 0 0 1rem 0;
  }
</style>
