---
import { teamMembers } from "../data/team";
import SectionIntro from "./SectionIntro.astro";
import SectionGrid from "./SectionGrid.astro";
import StaffBlock from "./grid-blocks/StaffBlock.astro";
import { url } from "../utils/url";
---

{
  teamMembers && (
    <SectionGrid
      eyebrow="People"
      heading="Meet the crew"
      body="Good people doing honest work, day in and day out."
      align="left"
      columns={4}
    >
      {teamMembers.map((member) => {
        return (
          <StaffBlock
            photo={member.photo}
            name={member.name}
            role={member.role}
            description={member.description}
          />
        );
      })}

      <div slot="cta" class="cta-careers">
        <h3 class="cta-careers__heading">Who we hire</h3>
        <p>
          We're always looking for skilled electricians and dedicated people who
          take pride in their work.
        </p>
        <a href={url("/careers")} class="btn btn-secondary">
          Careers
        </a>
      </div>
    </SectionGrid>
  )
}

<style>
  .cta-careers {
    width: 100%;
    margin: 2rem 0 0 0;
    border-top: 1px solid #ccc;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .cta-careers__heading {
    font-size: var(--text-xl);
    margin: 2rem 0 0 0;
  }

  .cta-careers .btn {
    margin-top: 1rem;
  }
</style>
